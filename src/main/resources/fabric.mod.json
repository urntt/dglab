{
	"schemaVersion": 1,
	"id": "dglab",
	"version": "${version}",
	"name": "dglab",
	"description": "Reflects in-game experiences to DG-LAB devices.",
	"authors": [
		"urntt"
	],
	"contact": {
		"homepage": "https://github.com/urntt/dglab",
		"sources": "https://github.com/urntt/dglab",
		"issues": "https://github.com/urntt/dglab/issues"
	},
	"license": "MIT",
	"icon": "assets/dglab/icon.png",
	"environment": "client",
	"entrypoints": {
		"client": [
			"com.urntt.dglab.DgLabClient"
		],
		"modmenu": [
			"com.urntt.dglab.compat.ModMenuIntegration"
		]
	},
	"mixins": [
		{
			"config": "dglab.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "~${minecraft_version}",
		"java": ">=${java_version}",
		"fabric-api": ">=${fabric_api_version}"
	},
	"suggests": {
		"modmenu": "*"
	}
}
